diff --git a/recompiler/src/cyc_codegen.c b/recompiler/src/cyc_codegen.c
--- a/recompiler/src/cyc_codegen.c
+++ b/recompiler/src/cyc_codegen.c
@@ -2608,1 +2608,15 @@
-    cyc_mkdir("generated");
+    /* Evaluation-only telemetry: identify each visited instruction start
+     * that cannot be emitted because its bytes cross a 4 KiB slot or $FFFF.
+     * This patch is applied only to a temporary checkout by the harness. */
+    for (size_t i = 0; i < pos_space(p); i++) {
+        if (!p->seen[i] || p->is_insn[i]) continue;
+        uint32_t bank = (uint32_t)(i >> 15);
+        uint32_t slot = (uint32_t)((i >> SLOT_SHIFT) & (SLOT_COUNT - 1));
+        uint32_t k = (uint32_t)(i & (SLOT_SIZE - 1));
+        uint16_t addr = (uint16_t)(0x8000 + (slot << SLOT_SHIFT) + k);
+        uint8_t opcode = prg_byte(p, bank, k);
+        fprintf(stderr,
+                "[TAIL_DIAGNOSTIC] bank=%u slot=%u addr=$%04X opcode=$%02X len=%d\n",
+                bank, slot, addr, opcode, op_length(opcode));
+    }
+    cyc_mkdir("generated");
