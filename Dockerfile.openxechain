FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang cmake ninja-build git build-essential bzip2 gzip findutils sed tar unzip zip \
    gawk python3 python3-yaml file ca-certificates xxd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app
RUN chmod +x /app/scripts/railway-openxechain-build.sh

ENV OPENXECHAIN_WORKDIR=/workspace/openxechain-cache
CMD ["bash", "-lc", "/app/scripts/railway-openxechain-build.sh && exec sleep infinity"]
